{
  "name": "jsql-devbox",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ],
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.js-debug"
      ]
    }
  },
  "forwardPorts": [3306, 5432, 27017, 6379, 8080],
  "portsAttributes": {
    "3306": { "label": "JSQL-NEO MySQL listener (not started by the image)", "onAutoForward": "ignore" },
    "5432": { "label": "JSQL-NEO PostgreSQL listener (not started by the image)", "onAutoForward": "ignore" },
    "27017": { "label": "JSQL-NEO MongoDB listener (not started by the image)", "onAutoForward": "ignore" },
    "6379": { "label": "JSQL-NEO Redis listener (not started by the image)", "onAutoForward": "ignore" },
    "8080": { "label": "JSQL-NEO HTTP / web UI (not started by the image)", "onAutoForward": "ignore" }
  },
  "postStartCommand": "bash /usr/local/bin/clone-jsql.sh"
}
